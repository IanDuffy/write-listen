# /etc/write-listen/env on the droplet: the app's keys and settings (DEPLOY.md). The service reads it
# (EnvironmentFile) and /srv/write-listen/.env links to it, so `wl` commands see the same keys.
# Owned by writelisten, mode 600. Never in the repository, never anywhere the browser can load.
# One KEY=value a line: no quotes, no spaces around "=". setup.sh copies this file there the first time;
# fill it in, then run setup.sh again.

# GPT-Live (the guide and the interviewer) and its backend. The browser never sees it: the server makes
# the connection offer for each conversation.
OPENAI_API_KEY=

# Claude: chapter builds, the chapter card, summaries. WRITE_LISTEN_ANTHROPIC_API_KEY is read first;
# set one of the two.
WRITE_LISTEN_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# The admin page (/admin). Caddy asks for this login (setup.sh puts a bcrypt hash of the password in the
# Caddyfile) and the app checks the same pair. User: letters, digits and . _ @ - only. Password: a long
# one of letters and digits (systemd and the shell treat other characters differently).
ADMIN_USER=ian
ADMIN_PASSWORD=

# The site's public address. Tester links are made from it; setup.sh takes Caddy's domain from it.
WL_BASE_URL=https://listen.ianduffy.com

# Tester mode: config.yaml keeps demo.enabled false (Ian's own laptop); WL_DEMO=1 turns it on here
# (cookies required, the gate, the interviewer). Without it the site would be the full app, open to
# anyone, so `wl deploy` stops the service if it finds tester mode off.
WL_DEMO=1

# Local time: the guide's sense of the time of day and the daily log files. setup.sh also sets the
# droplet's clock to it. A name such as America/New_York or Europe/London; empty means UTC.
TZ=

# Where the server listens. The service passes --host 127.0.0.1 --port 8765, which win over these.
# WL_HOST=127.0.0.1
# WL_PORT=8765
